# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL pública, sem barra no fim. Entra nos links do WhatsApp e no canonical.
PUBLIC_URL=http://localhost:3000

# ── Banco (docker compose up -d db) ────────────────────────────────────────
POSTGRES_USER=promoeye
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=promoeye
DATABASE_URL=postgresql://promoeye:troque-esta-senha@localhost:5433/promoeye?schema=public

# ── Sessão do painel ───────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-48-bytes-aleatorios-em-base64url-xxxxxxxxxxxx
SESSION_TTL_HOURS=24

# ── Coletor ────────────────────────────────────────────────────────────────
# Expressão cron da busca automática. Padrão: no minuto 5 de cada hora.
COLLECT_CRON=5 * * * *
# false desliga o agendamento (útil em dev); "Buscar agora" no painel continua funcionando.
COLLECT_ENABLED=true
# Pausa entre duas requisições à MESMA loja, em ms. Educação com o site alheio.
COLLECT_STORE_DELAY_MS=1500
COLLECT_TIMEOUT_MS=15000

# ── Black Friday: janelas com data marcada ─────────────────────────────────
# Datas ISO com fuso. Vazio = sem janela. Em produção as datas de 2026 já
# vêm do ops/vps/compose.yml; aqui só se quiser testar no computador.
# Pico: entre PEAK_FROM e PEAK_UNTIL a coleta roda a cada PEAK_EVERY_MIN
# minutos (10, 15, 20 ou 30) no lugar do COLLECT_CRON.
PEAK_FROM=
PEAK_UNTIL=
PEAK_EVERY_MIN=20
# WhatsApp sem horário de silêncio nesse intervalo (as lojas abrem à meia-noite).
QUIET_OFF_FROM=
QUIET_OFF_UNTIL=

# Atrás do Nginx em produção: true. Em dev: false.
TRUST_PROXY=false

# ── WhatsApp: envio automático pelo WAHA (gratuito) ────────────────────────
# Suba com `docker compose up -d waha` e conecte o número em Painel › WhatsApp.
# Vazio = sem envio automático (as mensagens continuam saindo à mão).
# Gere a chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
