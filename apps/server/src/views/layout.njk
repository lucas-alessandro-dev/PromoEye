<!doctype html>
{#
  Base de todas as páginas da vitrine, montada sobre o starter da taste-skill 2.5.

  type: software (um serviço web: o PromoEye confere preços; nada é vendido aqui)
  deal: hero collage · nav-centre · close-word · footer-dark · rhythm surface-pairs ·
        buttons arrow · mark dots · ground sky · features steps + tabs-tour
        (16/11/2026: o herói collage e o app-frame da home saíram para a listagem de loja;
        o resto do sorteio continua valendo)
  moment: marquee-row (os nomes das lojas conferidas, como palavras; nunca logos)
  palette: tokens do stitch (awesome-design-skills) pelo caminho "brand" da skill:
        fundo #F7F5EE, superfície #EDEADE (a do stitch), tinta #111827,
        laranja #FF5F03 escurecido para #E95603 até passar 3:1 nos dois fundos
        com rótulo 4.9:1; o petróleo #072C2C do stitch é o fundo inverso.
  type: Mona Sans (sorteada em library/type.json para software), display 500.
#}
{% from "partials/_macros.njk" import waIcon %}
<html lang="pt-BR" data-type="software" data-radius="soft" data-ground="sky" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
{% if not site.allowIndexing %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page.ogTitle or page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:image" content="{{ site.url }}/static/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#F7F5EE">
{% if site.canonical %}<link rel="canonical" href="{{ site.url }}{{ page.path }}">{% endif %}
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style>
:root {
  --p-bg: #F7F5EE; --p-surface: #EDEADE; --p-ink: #111827; --p-muted: #62656d;
  --p-accent: #E95603; --p-accent-ink: #111827; --p-action: #E95603; --p-action-ink: #111827;
  --p-inv-bg: #072C2C; --p-inv-surface: #183A3A; --p-inv-ink: #F7F5EE; --p-inv-muted: #9CA9A4;
  --p-inv-accent: #E95603; --p-inv-accent-ink: #111827; --p-inv-action: #E95603; --p-inv-action-ink: #111827;
  --font-display: "Mona Sans", system-ui, sans-serif;
  --font-text: "Mona Sans", system-ui, sans-serif;
  --display-weight: 500;
  --display-tracking: -0.03em;
  --display-tracking-xl: -0.04em;
  --display-stretch: 104%;
  --ly-scale: 0.96;
}
</style>
<link rel="stylesheet" href="/assets/ui/base.css">
<link rel="stylesheet" href="/assets/ui/window/fragment.css">
<link rel="stylesheet" href="/static/site.css">
<script nonce="{{ nonce }}">document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script src="/assets/backgrounds/backgrounds.js"></script>
{% if useMoments %}
<script nonce="{{ nonce }}">document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/marquee-row/moment.js">
{% endif %}
</head>
<body>
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Pular para o conteúdo</a>
    <a class="nav__logo" href="/#top" translate="no"><span class="mark" data-mark="dots" aria-hidden="true"></span>{{ site.title }}</a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item"><a class="nav__link" href="/#ofertas">Promoções</a></div>
      <div class="nav__item"><a class="nav__link" href="/#como-funciona">Como funciona</a></div>
      <div class="nav__item"><a class="nav__link" href="/#selos">Selos</a></div>
      <div class="nav__item"><a class="nav__link" href="/#perguntas">Perguntas</a></div>
    </nav>
    {# O grupo do WhatsApp é a ação principal do site: o botão verde fica na barra em toda página
       (no celular, encurtado para "Grupo"). Sem convite configurado, volta o "Ver as promoções". #}
    {% if site.whatsappInvite %}
    <div class="nav__actions nav__actions--wa">
      <a class="btn btn--primary btn--wa" href="{{ site.whatsappInvite }}" target="_blank" rel="noopener">{{ waIcon() }}<span>Grupo<span class="btn--wa__long"> do WhatsApp</span></span></a>
    </div>
    {% else %}
    <div class="nav__actions">
      <a class="btn btn--primary" href="/#ofertas">Ver as promoções</a>
    </div>
    {% endif %}
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
{% block main %}{% endblock %}
</main>

<footer class="footer closing footer--dark ground-inverse" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div>
          <h2 id="close-h">{% block closeTitle %}As promoções de hoje, conferidas{% endblock %}</h2>
          <p class="t-lead">{% if lastRunAt %}Última coleta às {{ lastRunAt | hourBR }}. A próxima sai no minuto 5 da hora que vem.{% else %}A primeira coleta sai no minuto 5 da próxima hora.{% endif %}</p>
        </div>
        <div class="btn-row">
          {% if site.whatsappInvite %}<a class="btn btn--primary btn--wa" href="{{ site.whatsappInvite }}" target="_blank" rel="noopener">{{ waIcon() }}Entrar no grupo do WhatsApp</a>{% endif %}
          <a class="btn {{ 'btn--secondary' if site.whatsappInvite else 'btn--primary' }}" href="/#ofertas">Ver as promoções<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
        </div>
      </div>
      <p class="close__word" aria-hidden="true" translate="no">{{ site.title }}</p>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="/#top" translate="no"><span class="mark" data-mark="dots" aria-hidden="true"></span>{{ site.title }}</a>
          <p class="footer__lede">Preço de Black Friday conferido de hora em hora.</p>
        </div>
        <div class="span-2 footer__col"><h3>Promoções</h3><ul><li><a href="/#ofertas">Menores preços</a></li>{% if site.whatsappInvite %}<li><a href="{{ site.whatsappInvite }}" rel="noopener">Grupo do WhatsApp</a></li>{% endif %}</ul></div>
        <div class="span-2 footer__col"><h3>Como funciona</h3><ul><li><a href="/#como-funciona">Os 3 passos</a></li><li><a href="/#como-funciona">As lojas</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Selos</h3><ul><li><a href="/#selos">Desconto real</a></li><li><a href="/#selos">Preço “de” inflado</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Perguntas</h3><ul><li><a href="/#perguntas">Perguntas frequentes</a></li><li><a href="/painel">Painel</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; {{ year }} {{ site.title }} &nbsp; {{ site.disclosure }}</span>
        <div class="socials"></div>
        <span class="credits">Fotos de produto: das próprias lojas. Nomes e marcas pertencem aos seus donos.</span>
      </div>
    </div>
  </div>
</footer>

<script type="module" src="/assets/system.js"></script>
<script type="module" src="/assets/motion/motion.js"></script>
<script type="module" src="/assets/layout/layout.js"></script>
<script type="module" src="/static/shop.js"></script>
</body>
</html>
