{% macro thumb(url, cls='') %}{% if url %}<img class="pe-thumb {{ cls }}" src="{{ url }}" alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer">{% else %}<span class="pe-thumb pe-thumb--empty {{ cls }}" aria-hidden="true"></span>{% endif %}{% endmacro %}

{# Preço grande no jeito das lojas: "R$ 3.220" com os centavos em sobrescrito. #}
{% macro bigPrice(value, cls) %}{% set pp = value | priceParts %}<span class="{{ cls }}"><span class="sr-only">{{ value | brl }}</span><span aria-hidden="true"><span class="{{ cls }}-cur">R$</span>{{ pp.int }}<sup>{{ pp.cents }}</sup></span></span>{% endmacro %}

{# Um item na listagem. O cartão inteiro leva à página do item; a loja fica a um clique de lá.
   index: posição na grade. Os primeiros aparecem sem rolar: foto sem lazy, e as 2 primeiras com prioridade. #}
{% macro productCard(c, index=99) %}
<li class="pc{% if not c.best %} pc--empty{% endif %}">
  <a class="pc__link" href="{{ c.href }}">
    <span class="pc__media">
      {% if c.imageUrl %}<img src="{{ c.imageUrl }}" alt="" width="400" height="400" {% if index <= 4 %}loading="eager"{% if index <= 2 %} fetchpriority="high"{% endif %}{% else %}loading="lazy"{% endif %} decoding="async" referrerpolicy="no-referrer">{% else %}<span class="pc__noimg" aria-hidden="true"></span>{% endif %}
      {% if c.isDeal %}<span class="pc__tag">Promoção de verdade</span>{% endif %}
    </span>
    <span class="pc__body">
      <h3 class="pc__title">{{ c.name }}</h3>
      {% if c.best %}
      <span class="pc__was">{% if c.best.showList %}<s><span class="sr-only">Preço anunciado antes: </span>{{ c.best.listPrice | brl }}</s>{% endif %}</span>
      <span class="pc__row">{{ bigPrice(c.best.price, 'pc__price') }}{% if c.best.listOff %}<span class="pc__off">{{ c.best.listOff | pct }} OFF</span>{% endif %}</span>
      {% if c.best.pixLower %}<span class="pc__inst">{{ c.best.pixLower | brl }} no Pix</span>{% elif c.best.installments %}<span class="pc__inst">{{ c.best.installments }}</span>{% endif %}
      <span class="pc__store">Menor preço · <b>{{ c.best.storeName }}</b></span>
      <span class="pc__cmp"><span class="pc__cmp-dot" aria-hidden="true"></span>{{ c.storeCount }} {{ 'loja comparada' if c.storeCount == 1 else 'lojas comparadas' }}</span>
      {% if c.flags.length %}<span class="pc__flags">{% for f in c.flags %}{{ chip(f) }}{% endfor %}</span>{% endif %}
      {% else %}
      <span class="pc__none">{% if c.soldOutStores %}Esgotado nas lojas pesquisadas{% else %}Sem oferta nas lojas agora{% endif %}</span>
      <span class="pc__cmp">Ver as lojas e o histórico</span>
      {% endif %}
    </span>
  </a>
</li>
{% endmacro %}

{# Uma oferta numa lista: foto, título, loja (e vendedor), preço, "de" e selos, e o link para a loja. #}
{% macro offerRow(o, showItem=false) %}
<li class="pe-offer{% if not o.available %} pe-offer--off{% endif %}">
  {{ thumb(o.imageUrl) }}
  <div class="pe-offer__text">
    {% if showItem %}<span class="pe-offer__item">{{ o.itemName }}</span>{% endif %}
    <a class="pe-offer__title" href="{{ o.href }}" rel="sponsored nofollow noopener">{{ o.title }}</a>
    <span class="pe-offer__meta">{{ o.storeName }}{% if o.sellerName %} · vendido por {{ o.sellerName }}{% endif %}{% if o.pixLower %} · {{ o.pixLower | brl }} no Pix{% endif %}{% if o.installments %} · {{ o.installments }}{% endif %}{% if o.productHref %} · <a class="pe-offer__prod" href="{{ o.productHref }}">mesmo produto em outras lojas</a>{% endif %}</span>
    {% if o.flags.length %}<span class="pe-offer__flags">{% for f in o.flags %}{% if loop.index <= 3 %}{{ chip(f) }}{% endif %}{% endfor %}</span>{% endif %}
  </div>
  <div class="pe-offer__price">
    {% if not o.available %}<span class="pe-offer__soldout">Esgotado</span>{% elif o.showList %}<s class="pe-offer__list"><span class="sr-only">Preço anunciado antes: </span>{{ o.listPrice | brlShort }}</s>{% endif %}
    <b>{{ o.price | brl }}</b>
    {% if o.realOff %}<span class="pe-offer__off">{{ o.realOff | pct }} abaixo do normal</span>{% endif %}
    {% if o.available %}<a class="pe-go" href="{{ o.href }}" rel="sponsored nofollow noopener" aria-label="Ir para a loja {{ o.storeName }}: {{ o.title }}">Ir para a loja</a>{% endif %}
  </div>
</li>
{% endmacro %}

{# Preço principal + Pix + cartão. A base da comparação é sempre o preço principal (ver Offer.pixPrice). #}
{% macro payLines(o, cls='buy') %}
{% if o.pixLower %}<p class="{{ cls }}__pix"><b>{{ o.pixLower | brl }}</b> no Pix</p>{% elif o.pixIsPrice %}<p class="{{ cls }}__pix">Preço no Pix</p>{% endif %}
{% if o.cardPrice %}<p class="{{ cls }}__inst">{{ o.cardPrice | brl }} no cartão{% if o.installments %} · {{ o.installments }}{% endif %}</p>{% elif o.installments %}<p class="{{ cls }}__inst">{{ o.installments }}</p>{% endif %}
{% endmacro %}

{# "Conferido há 12 min": quando o PromoEye viu ESTE preço na loja. Oferta manual não tem esse frescor. #}
{% macro checked(o) %}{% if o.manual %}Oferta cadastrada à mão{% else %}Preço conferido {{ o.lastSeenAt | ago }}{% endif %}{% endmacro %}

{# "Me avise quando baixar". Funciona sem JavaScript: POST /alertas e volta para cá com a mensagem. #}
{% macro alertForm(box, whatsappInvite=null) %}
<section class="alertbox" id="alerta" aria-labelledby="alerta-h">
  <h2 id="alerta-h" class="alertbox__title">Me avise quando baixar</h2>
  <p class="alertbox__lead">Um e-mail quando virar promoção de verdade (contra o nosso histórico), ou quando passar do preço que você escolher.</p>
  {% if box.message %}<p class="alertbox__msg alertbox__msg--{{ box.message.tone }}" role="{{ 'status' if box.message.tone == 'ok' else 'alert' }}">{{ box.message.text }}</p>{% endif %}
  <form class="alertbox__form" method="post" action="{{ box.action }}">
    <input type="hidden" name="kind" value="{{ box.kind }}">
    <input type="hidden" name="slug" value="{{ box.slug }}">
    <label class="alertbox__field"><span>Seu e-mail</span><input type="email" name="email" required maxlength="160" autocomplete="email" inputmode="email" spellcheck="false"></label>
    <label class="alertbox__field"><span>Avisar abaixo de <small>(opcional)</small></span><span class="alertbox__money"><span aria-hidden="true">R$</span><input type="text" name="targetPrice" maxlength="20" inputmode="decimal" autocomplete="off" placeholder="{{ box.placeholder }}" aria-label="Preço-alvo em reais (opcional)"></span></label>
    <div class="alertbox__hp" aria-hidden="true"><label>Deixe em branco <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
    <label class="alertbox__consent"><input type="checkbox" name="consent" required><span>{{ box.consentText }}</span></label>
    <button class="alertbox__submit" type="submit">Criar alerta</button>
  </form>
  <p class="alertbox__fine">Sem a confirmação pelo link do e-mail, nada é enviado. No máximo um aviso a cada 12 horas.{% if whatsappInvite %} Prefere o WhatsApp? <a href="{{ whatsappInvite }}" target="_blank" rel="noopener">Entre no grupo</a>.{% endif %}</p>
</section>
{% endmacro %}

{# Logo da loja (public/site/logos/<id>.svg); sem arquivo, o nome em texto. O alt é o nome: leitor de tela e busca leem a loja. #}
{% macro storeMark(id, name, cls='') %}{% set src = id | storeLogo %}{% if src %}<img class="slogo {{ cls }}" src="{{ src }}" alt="{{ name }}" title="{{ name }}" decoding="async">{% else %}<span class="slogo slogo--text {{ cls }}">{{ name }}</span>{% endif %}{% endmacro %}
